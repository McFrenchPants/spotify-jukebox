# Copy this file to .env and fill in real values. Never commit .env.

# Spotify Developer app (developer.spotify.com/dashboard). Use a DIFFERENT
# Spotify app (separate client ID/secret) here than whatever your production
# deployment (Docker/HA Add-on) uses, even against the same Spotify account —
# Spotify's rate limit is bucketed per client ID, so two instances sharing
# one client ID/refresh token and polling simultaneously can trip a 429 for
# both at once. See README.md's "Running locally" step 1 and
# backend/src/spotify/rateLimitBackoff.ts for the incident this guards against.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Spotify app.
SPOTIFY_REDIRECT_URI=http://localhost:3001/api/auth/callback

# PIN guests/admins enter to unlock admin controls (see DESIGN_SPEC §... admin auth).
ADMIN_PIN=change-me

# Backend HTTP port.
PORT=3001

# Path to the SQLite database file (created automatically if missing).
DB_PATH=./data/jukebox.db

# Optional. If set and no refresh token is stored yet, seeds it directly on
# first boot instead of requiring the one-time browser-based Spotify consent
# flow — useful for reusing a token already obtained by another deployment of
# this app (e.g. copy the value from that deployment's app_settings table).
# Never overwrites an existing stored token.
SPOTIFY_REFRESH_TOKEN=
