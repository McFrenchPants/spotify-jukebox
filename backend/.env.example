# Copy this file to .env and fill in real values. Never commit .env.

# Spotify Developer app (developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Spotify app.
SPOTIFY_REDIRECT_URI=http://localhost:3001/api/auth/callback

# PIN guests/admins enter to unlock admin controls (see DESIGN_SPEC §... admin auth).
ADMIN_PIN=change-me

# Backend HTTP port.
PORT=3001

# Path to the SQLite database file (created automatically if missing).
DB_PATH=./data/jukebox.db
